# collector/.env.example (docs/implementation-plan.md §11)
# コピーして `.env` を作り、実際の値を入れる。`.env` はコミット禁止。

WORKERS_BASE_URL=https://<your-worker>.workers.dev
INGEST_SECRET=<Workersと共有する乱数>
YOUTUBE_API_KEY=            # 任意。未設定なら youtube collector は無効になる
IG_SESSIONID=               # 任意・捨てアカ専用。後付けのログインセッション注入用。
                             # 手段3(ステルスブラウザ)を使うなら実質必須(未ログインだと
                             # プロフィールクエリ自体がIG側に拒否される)
IG_ENABLE_STEALTH=          # 任意。1/true/yes で手段3(StealthyFetcher)を有効化。
                             # Dockerイメージが `stealth` extra 込みでビルドされている
                             # ことが前提 (collector/Dockerfile 参照)。既定は無効
LOCAL_DB_PATH=/data/local.sqlite
COLLECTOR_LOG_LEVEL=INFO

# Instagram Graph API (管理アカウント example_account 専用。docs/dashboard-v3-plan.md §4)。
# 手順は collector/docs/graph-api-setup.md を参照。どちらか片方でも未設定なら
# example_account も含め通常の web collector にフォールバックする (壊れない)。
IG_GRAPH_TOKEN=              # 任意。長期アクセストークン
IG_GRAPH_USER_ID=            # 任意。example_account の Instagram Business User ID
